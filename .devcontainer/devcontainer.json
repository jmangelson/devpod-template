{
    "name": "jmangelson DevPod",

    "build": {
        "dockerfile": "Dockerfile",
        "args": {
            "USERNAME": "vscode",
            "USER_UID": "1000",
            "USER_GID": "1000",
            "ENABLE_LATEX": "false",
            "ENABLE_DOCKER_IN_DOCKER": "false",
            "ENABLE_ANDROID": "false",
            "ENABLE_ANDROID_EMULATOR": "false",
            "ANDROID_CMDLINE_TOOLS_VERSION": "15859902",
            "ANDROID_PLATFORM": "android-35",
            "ANDROID_BUILD_TOOLS": "36.0.0",
            "ANDROID_SYSTEM_IMAGE": "system-images;android-35;google_apis;x86_64",
            "ANDROID_KVM_GID": "993",
            "MAESTRO_VERSION": ""

            // ── LaTeX -- optional, off by default ────────────────────────
            // Set ENABLE_LATEX to true to install texlive-latex-extra and latexmk.
            // Set ENABLE_DOCKER_IN_DOCKER to true to install docker.io.

            // ── GUI (noVNC) -- optional, off by default ──────────────────
            // Uncomment to build the in-container Chrome/Xvfb/noVNC stack.
            // Most projects don't need it -- skip it for a smaller, faster
            // build. See the "GUI (noVNC)" section below too.
            // "ENABLE_GUI": "true"
        }
    },

    "remoteUser": "vscode",

    // Docker-in-Docker requires privileged container access.
    // Uncomment when ENABLE_DOCKER_IN_DOCKER is true:
    // "runArgs": ["--privileged"],

    // The Android emulator requires host KVM access and extra shared memory.
    // Uncomment when ENABLE_ANDROID_EMULATOR is true:
    // "runArgs": ["--device=/dev/kvm", "--group-add=993", "--shm-size=2g"],

    "remoteEnv": {
        "PATH": "/home/vscode/.local/bin:/home/vscode/.npm-global/bin:${containerEnv:PATH}"
    },

    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "charliermarsh.ruff",
                "anthropic.claude-code",
                "openai.codex",
                "ms-toolsai.jupyter"
            ],
            "settings": {
                "python.defaultInterpreterPath": "/home/vscode/.venv/bin/python"
            }
        }
    },

    // postCreateCommand repairs Android SDK ownership after DevPod remaps the
    // remote user's UID, then starts the X/VNC daemons. Both no-op instantly
    // when their optional layer is disabled.
    "postCreateCommand": "bash .devcontainer/fix-android-sdk-owner.sh && bash .devcontainer/start-display.sh",

    // ── GUI (noVNC) -- optional, off by default ────────────────────────────────
    // Only needed for projects that drive an in-container browser. To enable:
    //   1. Uncomment "ENABLE_GUI": "true" in build.args above.
    //   2. Uncomment containerEnv and forwardPorts below.
    //   3. If you run several devpods at once, give NOVNC_PORT/forwardPorts a
    //      value unique to this project -- devpod forwards the literal port
    //      number, so two workspaces both using 6080 will conflict.
    //   4. Rebuild with `devpod up . --recreate`.
    //
    // "containerEnv": { "DISPLAY": ":99", "NOVNC_PORT": "6080" },
    // "forwardPorts": [6080],

    // ── External mounts ──────────────────────────────────────────────────────
    // Add project-specific folder mounts here. They are NOT part of the image,
    // so adding or changing one only recreates the container (seconds, no rebuild).
    //
    // Format:
    //   "source=<host-path>,target=/workspaces/external/<name>,type=bind,consistency=cached"
    //
    // Example:
    //   "source=/mnt/c/Users/you/projects/my-project,target=/workspaces/external/my-project,type=bind,consistency=cached"
    //
    // Append ",readonly" to mount read-only (e.g. reference data you don't
    // want a stray write inside the container to touch):
    //   "source=/mnt/c/Users/you/reference-data,target=/workspaces/external/reference-data,type=bind,consistency=cached,readonly"
    //
    // Mix read-only + read-write within one tree by nesting a second mount at
    // a sub-path -- it shadows just that sub-path, regardless of the parent's
    // own read-only flag:
    //   "source=/mnt/c/Users/you/big-folder,target=/workspaces/external/big-folder,type=bind,consistency=cached,readonly",
    //   "source=/mnt/c/Users/you/big-folder/subfolder,target=/workspaces/external/big-folder/subfolder,type=bind,consistency=cached"
    "mounts": []
}
